# .gitignore

# Ambiente virtual Python — nunca deve ser versionado (pesado, específico da máquina).
# O arquivo antigo tentava ignorar isso, mas ficou corrompido (metade escrita em UTF-16 por
# cima de um arquivo UTF-8) — git nunca conseguiu interpretar essas regras, por isso ~16.6k
# arquivos do venv acabaram rastreados por engano. Reescrito do zero em UTF-8 puro.
venv/
__pycache__/
*.pyc

# Dados locais (banco de dados, fotos de produto, artes geradas) — não fazem parte do código,
# ficam de fora do repositório (um clone novo não traz banco nem imagens).
static/
instance/
instance/produtos.db

# Imagens rejeitadas pelo filtro de conteúdo (ver _imagem_e_segura no CLAUDE.md) — nunca
# versionar, mesmo motivo do static/: dado local, e nesse caso especificamente sensível.
quarentena_imagens/

# Logs
*.log

# Saída do PyInstaller (empacotamento em .exe — ver seção de packaging no CLAUDE.md), nunca
# versionada, sempre gerada localmente a partir do app.py.
build/
dist/
*.spec
